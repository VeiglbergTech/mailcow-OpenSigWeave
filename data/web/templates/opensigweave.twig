{% extends 'base.twig' %}

{% block content %}
<div class="card">
  <div class="card-header">
    <h4 class="mb-0">OpenSigWeave – E-Mail-Signaturen</h4>
  </div>
  <div class="card-body">
    <p>Verwalte Signaturen für aktive Mailcow-Domains.</p>

    {% if not has_access %}
    <div class="alert alert-danger" role="alert">
      Dein Mailcow-Administrator hat die OpenSigWeave-Berechtigung für dieses Domain-Administrator-Konto nicht freigegeben.
    </div>
    {% elseif domains is empty %}
    <div class="alert alert-info" role="status">
      Für dieses Konto sind derzeit keine aktiven Mailcow-Domains freigegeben.
    </div>
    {% else %}
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th>Mailcow-Domain</th>
            <th>Status</th>
            <th>Signaturverwaltung</th>
          </tr>
        </thead>
        <tbody>
          {% for domain in domains %}
          <tr>
            <td>{{ domain }}</td>
            <td><span class="badge bg-success">Aktiv</span></td>
            <td><span class="text-muted">Domainzugriff eingerichtet – Signatur-Editor folgt als nächster Schritt.</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
