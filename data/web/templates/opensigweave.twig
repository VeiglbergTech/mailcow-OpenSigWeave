{% extends 'base.twig' %}

{% block content %}
<div class="container-fluid osw-admin">
  <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div>
      <h1 class="mb-1"><i class="bi bi-envelope-paper"></i> OpenSigWeave</h1>
      <p class="text-muted mb-0">Zentrale Verwaltung dynamischer E-Mail-Signaturen</p>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-secondary" id="osw-refresh"><i class="bi bi-arrow-clockwise"></i> Aktualisieren</button>
      <button class="btn btn-danger" id="osw-new-signature"><i class="bi bi-plus-lg"></i> Neue Signatur</button>
    </div>
  </div>

  {% if not opensigweave_enabled %}
  <div class="alert alert-warning"><strong>Signatur-Injektion ist deaktiviert.</strong> Die Verwaltung kann vorbereitet werden; ausgehende Nachrichten erhalten weiterhin den normalen Mailcow-Footer.</div>
  {% endif %}
  <div id="osw-alert" class="alert d-none" role="status"></div>

  <div class="row g-4 mb-4">
  <div class="col-12 col-xl-6"><section class="card osw-panel">
    <div class="card-header d-flex justify-content-between align-items-center"><strong><i class="bi bi-collection"></i> Signaturgruppen</strong><button class="btn btn-sm btn-outline-light" id="osw-new-group">Gruppe</button></div>
    <div class="card-body"><div id="osw-groups" class="osw-list">Lade Gruppen …</div></div>
  </section></div>
  <div class="col-12 col-xl-6"><section class="card osw-panel">
    <div class="card-header d-flex justify-content-between align-items-center"><strong><i class="bi bi-diagram-3"></i> Regeln</strong><button class="btn btn-sm btn-outline-light" id="osw-new-rule">Regel</button></div>
    <div class="card-body"><div id="osw-rules" class="osw-list">Lade Regeln …</div></div>
  </section></div>
</div>
<div class="row g-4">
    <div class="col-12 col-xl-4">
      <section class="card osw-panel h-100">
        <div class="card-header d-flex align-items-center justify-content-between">
          <strong><i class="bi bi-globe2"></i> Domains</strong>
          <button class="btn btn-sm btn-outline-light" id="osw-new-domain"><i class="bi bi-plus-lg"></i> Domain</button>
        </div>
        <div class="card-body">
          <p class="text-muted small">Domains werden hier für die Signaturverwaltung freigeschaltet.</p>
          <div id="osw-domains" class="osw-list"><span class="text-muted">Lade Domains …</span></div>
        </div>
      </section>
    </div>
    <div class="col-12 col-xl-8">
      <section class="card osw-panel">
        <div class="card-header d-flex align-items-center justify-content-between">
          <strong><i class="bi bi-pen"></i> Signaturen</strong>
          <span class="badge text-bg-secondary" id="osw-signature-count">0</span>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover align-middle osw-table mb-0">
              <thead><tr><th>Name</th><th>Modus</th><th>Geltungsbereich</th><th>Status</th><th class="text-end">Aktionen</th></tr></thead>
              <tbody id="osw-signatures"><tr><td colspan="5" class="text-muted">Lade Signaturen …</td></tr></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<div class="modal fade" id="osw-signature-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content osw-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="osw-modal-title">Neue Signatur</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Schließen"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="osw-signature-id">
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label" for="osw-signature-name">Signaturname</label>
            <input class="form-control" id="osw-signature-name" maxlength="255" required>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="osw-signature-mode">Modus</label>
            <select class="form-select" id="osw-signature-mode">
              <option value="AUTO">Automatisch</option>
              <option value="PROFESSIONAL">Professionell</option>
              <option value="INTERNAL">Intern</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label" for="osw-signature-weight">Gewichtung</label>
            <input class="form-control" id="osw-signature-weight" type="number" min="1" max="100000" value="1">
          </div>
          <div class="col-12">
            <label class="form-label" for="osw-signature-domains">Zugeordnete Domains</label>
            <select class="form-select" id="osw-signature-domains" multiple size="4"></select>
            <div class="form-text">Keine Auswahl bedeutet globale Verfügbarkeit.</div>
          </div>
        </div>
        <label class="form-label" for="osw-signature-html">HTML-Signatur</label>
        <textarea id="osw-signature-html"></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
        <button type="button" class="btn btn-danger" id="osw-save-signature">Speichern</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="osw-group-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content osw-modal">
    <div class="modal-header"><h5 class="modal-title">Signaturgruppe anlegen</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body">
      <label class="form-label" for="osw-group-name">Gruppenname</label><input class="form-control mb-3" id="osw-group-name" maxlength="255">
      <label class="form-label" for="osw-group-members">Signaturen (gewichtete Rotation, Standardgewicht 1)</label><select class="form-select mb-3" id="osw-group-members" multiple size="5"></select>
      <label class="form-label" for="osw-group-domains">Domains (leer = alle Domains)</label><select class="form-select" id="osw-group-domains" multiple size="4"></select>
    </div>
    <div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-danger" id="osw-save-group">Gruppe speichern</button></div>
  </div></div>
</div>
<div class="modal fade" id="osw-rule-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content osw-modal">
    <div class="modal-header"><h5 class="modal-title">Regel anlegen</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><div class="row g-3">
      <div class="col-md-8"><label class="form-label" for="osw-rule-name">Regelname</label><input class="form-control" id="osw-rule-name" maxlength="255"></div>
      <div class="col-md-4"><label class="form-label" for="osw-rule-priority">Priorität</label><input class="form-control" id="osw-rule-priority" type="number" value="0"></div>
      <div class="col-md-6"><label class="form-label" for="osw-rule-action">Aktion</label><select class="form-select" id="osw-rule-action"><option>AUTO</option><option>PROFESSIONAL</option><option>INTERNAL</option><option>NONE</option><option>GROUP</option></select></div>
      <div class="col-md-6"><label class="form-label" for="osw-rule-signature">Signatur (optional)</label><select class="form-select" id="osw-rule-signature"></select></div>
      <div class="col-12"><label class="form-label" for="osw-rule-group">Gruppe (für Aktion GROUP)</label><select class="form-select" id="osw-rule-group"></select></div>
      <div class="col-md-4"><label class="form-label" for="osw-rule-condition">Bedingung</label><select class="form-select" id="osw-rule-condition"><option value="">Keine</option><option value="sender_equals">Absender exakt</option><option value="domain_equals">Domain exakt</option><option value="group_contains">Gruppe enthält</option><option value="claim_equals">Claim exakt</option><option value="attribute_equals">Attribut exakt</option></select></div>
      <div class="col-md-4"><label class="form-label" for="osw-rule-key">Schlüssel (Claim/Attribut)</label><input class="form-control" id="osw-rule-key"></div>
      <div class="col-md-4"><label class="form-label" for="osw-rule-value">Wert</label><input class="form-control" id="osw-rule-value"></div>
    </div></div>
    <div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button><button class="btn btn-danger" id="osw-save-rule">Regel speichern</button></div>
  </div></div>
</div>
<script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
<script>
var oswCsrfToken = '{{ csrf_token }}';
</script>
{% endblock %}
